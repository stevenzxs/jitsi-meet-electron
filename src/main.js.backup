const path = require('path');
const fs = require('fs');
const crypto = require('crypto');
const { spawn } = require('child_process');
const { createShareController } = require('./share-controller');
let shareController;
let ffmpegStaticPath = null;
try {
  ffmpegStaticPath = require('ffmpeg-static');
} catch (error) {
  console.warn('[recording] FFmpeg dependency unavailable, WebM fallback enabled:', error?.message || error);
}
// 采集运行时同时供"预加载未覆盖 frame"的兜底注入使用；
// 主进程 require 时文件底部走 module.exports 分支，不会执行页面侧逻辑。
const { installCaptureRuntime } = require('./share-capture-preload.js');
const { app, BrowserWindow, Menu, ipcMain,
  dialog, shell, session, desktopCapturer, nativeTheme, screen } = require('electron');

// 强制 Electron chrome（系统标题栏/菜单栏）走浅色，与 Web 端浅色主题一致。
nativeTheme.themeSource = 'light';

// 内网服务器普遍使用自签证书：Chromium 在 TLS 握手阶段就直接拒绝（net_error -202），
// app 级 certificate-error 回调覆盖不到所有网络栈路径，必须在启动早期用命令行开关放行。
app.commandLine.appendSwitch('ignore-certificate-errors');

// 部分运行环境（虚拟机/远程桌面/显卡驱动异常）GPU 进程会反复崩溃（exit_code=34），
// 连带摄像头 Bind context provider 失败。崩溃后落标记文件并重启，之后固定走软件渲染；
// 健康机器没有崩溃就不会写标记，GPU 策略保持不变。
const gpuFallbackFlagPath = path.join(app.getPath('userData'), 'cloudmeet-disable-gpu');
if (fs.existsSync(gpuFallbackFlagPath)) {
  app.disableHardwareAcceleration();
}

const PROTOCOL = 'cloudmeet';
const APP_ICON = path.join(__dirname, '..', 'assets', 'icons', process.platform === 'win32' ? 'zhsz.ico' : 'zhsz.png');

let mainWindow;
let pendingInvite = null;
let sharePickerSequence = 0;
const sharePickerRequests = new Map();
const fullscreenControlWatchers = new Map();
const recordingSessions = new Map();
const pendingRecordingCaptures = new Map();
const RECORDING_CAPTURE_PREPARE_TTL_MS = 8000;

/** 窗口图标统一走 zhsz 资源；文件缺失时交给 Electron 使用默认图标，避免启动失败。 */
function getWindowIcon() {
  return fs.existsSync(APP_ICON) ? APP_ICON : undefined;
}

/** 服务器地址持久化文件放在 userData 目录，重启后仍指向用户配置的服务器。 */
function getServerFilePath() {
  return path.join(app.getPath('userData'), 'cloudmeet-server.json');
}

/** 只接受 http(s) 绝对地址，拒绝脏数据进入持久化存储。 */
function normalizeServerUrl(rawUrl) {
  if (typeof rawUrl !== 'string' || !rawUrl.trim()) return '';
  try {
    const url = new URL(rawUrl.trim());
    if (!['http:', 'https:'].includes(url.protocol)) return '';
    return url.href;
  } catch {
    return '';
  }
}

function readStoredServerUrl() {
  try {
    return normalizeServerUrl(JSON.parse(fs.readFileSync(getServerFilePath(), 'utf8')).url);
  } catch {
    /* 文件不存在或损坏时按未配置处理，渲染层回退编译期默认地址 */
  }
  return '';
}

function writeStoredServerUrl(url) {
  try {
    fs.mkdirSync(path.dirname(getServerFilePath()), { recursive: true });
    fs.writeFileSync(getServerFilePath(), JSON.stringify({ url }, null, 2), 'utf8');
  } catch (error) {
    console.error('保存服务器配置失败', error);
  }
}

function getSettingsFilePath() {
  return path.join(app.getPath('userData'), 'cloudmeet-settings.json');
}

function getDefaultRecordingDirectory() {
  return path.join(app.getPath('videos'), 'CloudMeet Recordings');
}

function normalizeRecordingDirectory(directory) {
  if (typeof directory !== 'string' || !directory.trim()) {
    return getDefaultRecordingDirectory();
  }
  return path.resolve(directory.trim());
}

function normalizeTilePollingSeconds(value) {
  if (value === undefined || value === null || value === '') return 60;
  const seconds = Number(value);
  if (!Number.isFinite(seconds)) return 60;
  const rounded = Math.round(seconds);
  if (rounded <= 0) return 0;
  return Math.min(7200, Math.max(15, rounded));
}

function normalizeDesktopSettings(settings = {}) {
  const recording = settings?.recording || {};
  const video = settings?.video || {};
  // 旧版配置是分钟字段（tilePollingMinutes），读取时按 ×60 兼容换算为秒。
  const legacyMinutes = Number(video.tilePollingMinutes);
  const seconds = video.tilePollingSeconds ?? (Number.isFinite(legacyMinutes) ? legacyMinutes * 60 : undefined);
  return {
    recording: {
      directory: normalizeRecordingDirectory(recording.directory),
      recordAudioFile: Boolean(recording.recordAudioFile),
    },
    video: {
      tilePollingSeconds: normalizeTilePollingSeconds(seconds),
    },
  };
}

function readStoredSettings() {
  try {
    return normalizeDesktopSettings(JSON.parse(fs.readFileSync(getSettingsFilePath(), 'utf8')));
  } catch {
    return normalizeDesktopSettings();
  }
}

function writeStoredSettings(settings) {
  const normalized = normalizeDesktopSettings(settings);
  try {
    fs.mkdirSync(path.dirname(getSettingsFilePath()), { recursive: true });
    fs.writeFileSync(getSettingsFilePath(), JSON.stringify(normalized, null, 2), 'utf8');
  } catch (error) {
    console.error('保存桌面设置失败', error);
  }
  return normalized;
}

function sanitizeFileNamePart(value, fallback = '会议录屏') {
  const text = String(value || '')
    .replace(/[<>:"/\\|?*\x00-\x1F]/g, '_')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 60);
  return text || fallback;
}

function formatRecordingTimestamp(date = new Date()) {
  const pad = (value) => String(value).padStart(2, '0');
  return [
    date.getFullYear(),
    pad(date.getMonth() + 1),
    pad(date.getDate()),
    '-',
    pad(date.getHours()),
    pad(date.getMinutes()),
    pad(date.getSeconds()),
  ].join('');
}

function uniqueRecordingPath(directory, fileName) {
  const parsed = path.parse(fileName);
  for (let index = 0; index < 1000; index++) {
    const suffix = index === 0 ? '' : `-${index + 1}`;
    const candidate = path.join(directory, `${parsed.name}${suffix}${parsed.ext}`);
    if (!fs.existsSync(candidate)) return candidate;
  }
  return path.join(directory, `${parsed.name}-${crypto.randomUUID().slice(0, 8)}${parsed.ext}`);
}

function normalizeChunkBuffer(data) {
  if (!data) return Buffer.alloc(0);
  if (Buffer.isBuffer(data)) return data;
  if (data instanceof ArrayBuffer) return Buffer.from(new Uint8Array(data));
  if (ArrayBuffer.isView(data)) return Buffer.from(data.buffer, data.byteOffset, data.byteLength);
  return Buffer.alloc(0);
}

function writeStreamChunk(stream, buffer) {
  if (!buffer.length) return Promise.resolve();
  return new Promise((resolve, reject) => {
    stream.write(buffer, (error) => {
      if (error) reject(error);
      else resolve();
    });
  });
}

function closeWriteStream(stream) {
  return new Promise((resolve, reject) => {
    stream.once('error', reject);
    stream.end(resolve);
  });
}

function destroyRecordingSession(session, removeFiles = false) {
  for (const stream of [session.videoStream, session.audioStream].filter(Boolean)) {
    stream.destroy();
  }
  if (!removeFiles) return;
  for (const filePath of [session.videoFilePath, session.mp4FilePath, session.audioFilePath].filter(Boolean)) {
    try {
      fs.unlinkSync(filePath);
    } catch {
      /* ignore cleanup errors */
    }
  }
}

/** 用户名持久化文件放在 userData 目录，避免 Web 端 localStorage 被清理后丢失。 */
function getUserFilePath() {
  return path.join(app.getPath('userData'), 'cloudmeet-user.json');
}

function readStoredUser() {
  try {
    return normalizeStoredUser(JSON.parse(fs.readFileSync(getUserFilePath(), 'utf8')));
  } catch {
    /* 文件不存在或损坏时按无用户处理 */
  }
  return null;
}

function writeStoredUser(user) {
  try {
    fs.mkdirSync(path.dirname(getUserFilePath()), { recursive: true });
    fs.writeFileSync(getUserFilePath(), JSON.stringify(user, null, 2), 'utf8');
  } catch (error) {
    console.error('保存用户信息失败', error);
  }
}

/** 首次创建用户时生成稳定 ID；后续修改昵称只更新 name，不再重算 userId。 */
function createUserId() {
  return crypto.randomUUID().replace(/-/g, '').slice(0, 16);
}

/** 桌面端只接受短 ID 或旧 32 位 ID，避免把脏数据同步进本机存储。 */
function normalizeUserId(userId) {
  if (typeof userId !== 'string') return '';
  const trimmed = userId.trim();
  return /^[a-f0-9]{16}$/i.test(trimmed) || /^[a-f0-9]{32}$/i.test(trimmed) ? trimmed.toLowerCase() : '';
}

/** 旧版本保存的是 32 位 ID；读取时折短展示，并保留旧 ID 继续查询历史会议。 */
function normalizeStoredUser(user) {
  if (!user || typeof user.name !== 'string' || !user.name.trim()) return null;
  const normalizedId = normalizeUserId(user.userId);
  if (!normalizedId) return null;
  const legacyUserIds = mergeLegacyUserIds(
    normalizedId.length === 32 ? [normalizedId] : [],
    Array.isArray(user.legacyUserIds) ? user.legacyUserIds : [],
  );
  return {
    name: user.name.trim(),
    userId: normalizedId.length === 32 ? normalizedId.slice(0, 16) : normalizedId,
    ...(legacyUserIds.length ? { legacyUserIds } : {}),
  };
}

function mergeLegacyUserIds(...groups) {
  return groups
    .flat()
    .map((id) => (typeof id === 'string' ? id.trim().toLowerCase() : ''))
    .filter((id, index, ids) => /^[a-f0-9]{32}$/.test(id) && ids.indexOf(id) === index);
}

function sendToRenderer(channel, payload) {
  if (mainWindow && !mainWindow.isDestroyed()) {
    mainWindow.webContents.send(channel, payload);
  }
}

/** 向指定窗口发送 IPC，二次唤起或会议窗口场景不再强依赖主窗口存在。 */
function sendToWindow(win, channel, payload) {
  if (win && !win.isDestroyed()) {
    win.webContents.send(channel, payload);
  }
}

function getFfmpegExecutablePath() {
  if (!ffmpegStaticPath) return '';
  // Executables cannot run from inside app.asar. Forge unpacks the static binary
  // beside the archive in production; development keeps the original path.
  const unpackedPath = ffmpegStaticPath.replace(/\.asar([\\/])/, '.asar.unpacked$1');
  if (unpackedPath !== ffmpegStaticPath && fs.existsSync(unpackedPath)) return unpackedPath;
  return fs.existsSync(ffmpegStaticPath) ? ffmpegStaticPath : '';
}

function transcodeWebmToMp4(inputPath, outputPath) {
  const executablePath = getFfmpegExecutablePath();
  if (!executablePath) return Promise.reject(new Error('FFmpeg 不可用'));

  return new Promise((resolve, reject) => {
    const ffmpeg = spawn(executablePath, [
      '-hide_banner', '-loglevel', 'error', '-y',
      '-i', inputPath,
      '-map', '0:v:0', '-map', '0:a:0?',
      '-c:v', 'libx264', '-preset', 'veryfast', '-crf', '23', '-pix_fmt', 'yuv420p',
      '-c:a', 'aac', '-b:a', '128k', '-movflags', '+faststart', outputPath,
    ], { windowsHide: true });
    let stderr = '';
    ffmpeg.stderr?.on('data', (chunk) => { stderr += chunk.toString(); });
    ffmpeg.once('error', reject);
    ffmpeg.once('close', (code) => {
      if (code === 0 && fs.existsSync(outputPath) && fs.statSync(outputPath).size > 0) {
        resolve();
        return;
      }
      reject(new Error(stderr.trim() || `FFmpeg 退出码 ${code}`));
    });
  });
}

function broadcastDesktopSettings(settings) {
  for (const win of BrowserWindow.getAllWindows()) {
    sendToWindow(win, 'desktop-settings-changed', settings);
  }
}

function sendWindowFullscreenState(win, fullscreen) {
  if (!isUsableWindow(win)) return;
  const isFullscreen = Boolean(fullscreen ?? win.isFullScreen());
  sendToWindow(win, 'window-fullscreen', isFullscreen);
  if (isFullscreen) {
    startWindowFullscreenControlsWatcher(win);
  } else {
    stopWindowFullscreenControlsWatcher(win);
  }
}

function bindWindowFullscreenEvents(win) {
  win.on('enter-full-screen', () => sendWindowFullscreenState(win, true));
  win.on('leave-full-screen', () => sendWindowFullscreenState(win, false));
  win.on('enter-html-full-screen', () => sendWindowFullscreenState(win, true));
  win.on('leave-html-full-screen', () => sendWindowFullscreenState(win, win.isFullScreen()));
  win.on('closed', () => stopWindowFullscreenControlsWatcher(win));
}

function sendWindowFullscreenControlsVisible(win, visible) {
  sendToWindow(win, 'window-fullscreen-controls-visible', Boolean(visible));
}

function setWindowFullscreenControlsVisible(win, visible) {
  const watcher = fullscreenControlWatchers.get(win);
  const nextVisible = Boolean(visible);
  if (watcher) {
    if (watcher.visible === nextVisible) return;
    watcher.visible = nextVisible;
  }
  sendWindowFullscreenControlsVisible(win, nextVisible);
}

function isPointInsideBounds(point, bounds) {
  return (
    point.x >= bounds.x
    && point.x < bounds.x + bounds.width
    && point.y >= bounds.y
    && point.y < bounds.y + bounds.height
  );
}

function updateWindowFullscreenControlsVisible(win) {
  if (!isUsableWindow(win)) {
    stopWindowFullscreenControlsWatcher(win);
    return;
  }
  if (!win.isFullScreen()) {
    setWindowFullscreenControlsVisible(win, false);
    return;
  }
  const fullscreenBounds = screen.getDisplayMatching(win.getBounds()).bounds;
  setWindowFullscreenControlsVisible(win, isPointInsideBounds(screen.getCursorScreenPoint(), fullscreenBounds));
}

function startWindowFullscreenControlsWatcher(win) {
  if (!isUsableWindow(win) || fullscreenControlWatchers.has(win)) return;
  const watcher = {
    visible: false,
    timer: setInterval(() => updateWindowFullscreenControlsVisible(win), 100),
  };
  fullscreenControlWatchers.set(win, watcher);
  updateWindowFullscreenControlsVisible(win);
}

function stopWindowFullscreenControlsWatcher(win) {
  const watcher = fullscreenControlWatchers.get(win);
  if (watcher) {
    clearInterval(watcher.timer);
    fullscreenControlWatchers.delete(win);
  }
  sendWindowFullscreenControlsVisible(win, false);
}

/**
 * 注册桌面 Deep Link 协议；开发模式需要把入口脚本路径传给 Electron，
 * 否则 Windows 再次打开协议时只会启动 electron.exe 而找不到当前应用。
 */
function registerProtocolClient() {
  if (process.defaultApp && process.argv.length >= 2) {
    app.setAsDefaultProtocolClient(PROTOCOL, process.execPath, [path.resolve(process.argv[1])]);
    return;
  }
  app.setAsDefaultProtocolClient(PROTOCOL);
}

/** 从命令行参数中取出 cloudmeet:// 链接，Windows/Linux 的二次唤起会走这里 */
function findProtocolUrl(argv) {
  return argv.find((arg) => typeof arg === 'string' && arg.startsWith(`${PROTOCOL}://`)) || '';
}

/** 解析协议链接，只接受 join 动作和 9 位数字会议号，避免异常 URL 影响桌面壳状态 */
function parseInviteUrl(rawUrl) {
  if (!rawUrl) return null;
  try {
    const url = new URL(rawUrl);
    const action = url.hostname || url.pathname.replace(/^\/+/, '');
    const roomName = (url.searchParams.get('room') || '').replace(/\D/g, '').slice(0, 9);
    if (url.protocol !== `${PROTOCOL}:` || action !== 'join' || roomName.length !== 9) {
      return null;
    }
    const webBaseUrl = parseWebBaseUrl(url.searchParams.get('web') || '');
    return {
      roomName,
      subject: (url.searchParams.get('subject') || '').trim(),
      ...(webBaseUrl ? { webBaseUrl } : {}),
    };
  } catch {
    return null;
  }
}

function parseWebBaseUrl(rawBaseUrl) {
  if (!rawBaseUrl) return '';
  try {
    const url = new URL(rawBaseUrl);
    if (!['http:', 'https:'].includes(url.protocol)) {
      return '';
    }
    url.search = '';
    url.hash = '';
    if (!url.pathname.endsWith('/')) {
      url.pathname = `${url.pathname}/`;
    }
    return url.href;
  } catch {
    return '';
  }
}

function isUsableWindow(win) {
  return Boolean(win && !win.isDestroyed());
}

/** 邀请链接进来时优先复用已存在窗口，避免应用运行中又拉起一个主窗口。 */
function getInviteTargetWindow() {
  if (isUsableWindow(mainWindow)) {
    return mainWindow;
  }

  const focusedWindow = BrowserWindow.getFocusedWindow();
  if (isUsableWindow(focusedWindow)) {
    return focusedWindow;
  }

  for (const win of meetingWindows.keys()) {
    if (isUsableWindow(win)) {
      return win;
    }
  }

  return BrowserWindow.getAllWindows().find(isUsableWindow) || null;
}

function focusWindow(win) {
  if (!isUsableWindow(win)) return;
  if (win.isMinimized()) {
    win.restore();
  }
  win.show();
  // Windows 上从最小化恢复后，显式移到顶层可避免会后弹窗留在后台不可见。
  if (typeof win.moveTop === 'function') {
    win.moveTop();
  }
  win.focus();
}

/** 选择当前可用窗口作为共享选择器父窗口，防止会议窗口背后的页面抢焦点。 */
function getSharePickerParentWindow() {
  const focusedWindow = BrowserWindow.getFocusedWindow();
  if (isUsableWindow(focusedWindow)) {
    return focusedWindow;
  }
  if (isUsableWindow(mainWindow)) {
    return mainWindow;
  }
  return BrowserWindow.getAllWindows().find(isUsableWindow) || null;
}

function getWindowForFrame(frame) {
  if (!frame) return null;

  let frameTreeNodeId = 0;
  try {
    if (typeof frame.isDestroyed === 'function' && frame.isDestroyed()) return null;
    if (frame.detached) return null;
    frameTreeNodeId = frame.frameTreeNodeId;
  } catch {
    return null;
  }

  for (const win of BrowserWindow.getAllWindows()) {
    if (!isUsableWindow(win) || win.webContents.isDestroyed()) continue;
    try {
      const frames = win.webContents.mainFrame?.framesInSubtree || [];
      if (frames.some((candidate) => candidate.frameTreeNodeId === frameTreeNodeId)) {
        return win;
      }
    } catch {
      /* 忽略已销毁或正在导航的 frame */
    }
  }

  return null;
}

function pruneExpiredRecordingCaptures(now = Date.now()) {
  for (const [windowId, capture] of pendingRecordingCaptures.entries()) {
    if (!capture || capture.expiresAt <= now) {
      pendingRecordingCaptures.delete(windowId);
    }
  }
}

function prepareRecordingCaptureForWindow(win) {
  if (!isUsableWindow(win) || !meetingWindows.has(win)) {
    return { ok: false, error: '录屏仅支持会议窗口' };
  }

  pruneExpiredRecordingCaptures();
  pendingRecordingCaptures.set(win.id, { expiresAt: Date.now() + RECORDING_CAPTURE_PREPARE_TTL_MS });
  return { ok: true };
}

function consumePreparedRecordingCapture(frame) {
  const win = getWindowForFrame(frame);
  if (!isUsableWindow(win) || !meetingWindows.has(win)) return null;

  pruneExpiredRecordingCaptures();
  const capture = pendingRecordingCaptures.get(win.id);
  if (!capture) return null;

  pendingRecordingCaptures.delete(win.id);
  return frame;
}

function hasContentWindow() {
  if (isUsableWindow(mainWindow)) {
    return true;
  }
  for (const win of meetingWindows.keys()) {
    if (isUsableWindow(win)) {
      return true;
    }
  }
  return false;
}

/** 没有主窗口或会议窗口时退出应用；共享选择器是临时窗口，不算业务窗口。 */
function quitIfNoContentWindow() {
  if (process.platform !== 'darwin' && !hasContentWindow()) {
    app.quit();
  }
}

/** 聚焦已有窗口并把邀请交给渲染层；窗口还没加载好时先缓存，等待 did-finish-load 后发送。 */
function dispatchInvite(invite) {
  if (!invite) return;
  pendingInvite = invite;
  if (!app.isReady()) {
    return;
  }
  const targetWindow = getInviteTargetWindow();
  if (!targetWindow) {
    createMainWindow();
    return;
  }
  focusWindow(targetWindow);
  if (!targetWindow.webContents.isLoading()) {
    sendToWindow(targetWindow, 'desktop-invite-received', pendingInvite);
    pendingInvite = null;
  }
}

function flushPendingInvite(targetWindow = getInviteTargetWindow()) {
  if (pendingInvite) {
    sendToWindow(targetWindow, 'desktop-invite-received', pendingInvite);
    pendingInvite = null;
  }
}

function getShareableWindowSources(sources) {
  const ownHandles = getOwnWindowHandleIds();
  return sources.filter((source) => {
    if (!source.id.startsWith('window:') || !source.name) return false;
    // 企业微信的 WeMail 窗口无法正常捕获，不进入可选共享源列表。
    if (/^wemail$/i.test(source.name.trim())) return false;
    // 本端窗口（会议窗口/悬浮条/选择器）按原生句柄精确排除，避免共享会议窗口自身造成递归。
    const handleId = source.id.split(':')[1];
    if (handleId && ownHandles.has(handleId)) return false;
    return !source.name.startsWith('cloudmeet');
  });
}

/** 收集本端所有窗口的原生句柄（Windows 上即 HWND），用于在共享源列表中精确排除自身。 */
function getOwnWindowHandleIds() {
  const ids = new Set();
  for (const win of BrowserWindow.getAllWindows()) {
    try {
      const handle = win.getNativeWindowHandle();
      if (!handle || handle.length === 0) continue;
      // HWND 为指针大小：x64 8 字节，ia32 4 字节。
      ids.add(handle.length >= 8 ? handle.readBigUInt64LE(0).toString() : handle.readUInt32LE(0).toString());
    } catch {
      /* 窗口销毁竞态，忽略 */
    }
  }
  return ids;
}

function getShareableScreenSources(sources) {
  return sources.filter((source) => source.id.startsWith('screen:') && source.name);
}

/** 把 Electron 的 NativeImage 转成前端可渲染的数据，选择结果仍按 source id 回到主进程查原对象。 */
function serializeDesktopSource(source, type) {
  // 部分可共享应用暂时没有有效缩略图，
  // 空白缩略图不下发，前端回退为"图标+名称"占位。
  const thumbnail = source.thumbnail && !isBlankThumbnail(source.thumbnail) ? source.thumbnail.toDataURL() : '';
  return {
    id: source.id,
    type,
    name: source.name || '未命名',
    thumbnail,
    appIcon: source.appIcon?.toDataURL() || '',
  };
}

/** 采样位图判断缩略图是否为空白：全透明，或所有像素几乎是同一颜色（白/黑纯色图均为抓帧失败）。 */
function isBlankThumbnail(image) {
  try {
    if (!image || image.isEmpty()) return true;
    const bitmap = image.getBitmap();
    if (!bitmap || bitmap.length < 4) return true;

    let opaqueSamples = 0;
    let minR = 255, maxR = 0, minG = 255, maxG = 0, minB = 255, maxB = 0;
    const step = 16 * 4; // 每 16 个像素采样一次
    for (let i = 0; i + 3 < bitmap.length; i += step) {
      const alpha = bitmap[i + 3];
      if (alpha < 16) continue;
      opaqueSamples++;
      const b = bitmap[i], g = bitmap[i + 1], r = bitmap[i + 2];
      if (r < minR) minR = r; if (r > maxR) maxR = r;
      if (g < minG) minG = g; if (g > maxG) maxG = g;
      if (b < minB) minB = b; if (b > maxB) maxB = b;
    }
    if (opaqueSamples === 0) return true;
    // 真实窗口截图几乎不可能是纯色；RGB 各通道波动极小即为抓帧失败的纯色图
    return (maxR - minR) < 12 && (maxG - minG) < 12 && (maxB - minB) < 12;
  } catch {
    return false;
  }
}

function finishSharePickerRequest(requestId, selection = {}) {
  const request = sharePickerRequests.get(requestId);
  if (!request) return;
  sharePickerRequests.delete(requestId);

  const sourceId = selection.sourceId || '';
  const selectedSource = sourceId ? request.sources.find((source) => source.id === sourceId) || null : null;
  request.resolve({
    source: selectedSource,
    shareAudio: Boolean(selection.shareAudio),
  });

  if (isUsableWindow(request.window)) {
    request.window.close();
  }
}

/** 异步加载共享源，让选择器窗口可以先显示加载态，避免用户点击后长时间无反馈。 */
async function loadSharePickerSources(requestId) {
  const sources = await desktopCapturer.getSources({
    types: ['screen', 'window'],
    thumbnailSize: { width: 300, height: 174 },
    fetchWindowIcons: true,
  });
  const windows = getShareableWindowSources(sources).slice(0, 40);
  const screens = getShareableScreenSources(sources).slice(0, 12);
  const request = sharePickerRequests.get(requestId);

  if (!request) {
    return { windows: [], screens: [] };
  }

  request.sources = [...windows, ...screens];
  request.payload = {
    windows: windows.map((source) => serializeDesktopSource(source, 'window')),
    screens: screens.map((source) => serializeDesktopSource(source, 'screen')),
  };

  return request.payload;
}

/** 使用自定义窗口展示共享源，保留缩略图和窗口/屏幕分组，避免系统消息框体验粗糙。 */
function openSharePickerWindow(parentOverride, signal, options = {}) {
  const requestId = `share-picker-${Date.now()}-${++sharePickerSequence}`;
  const parentWindow = parentOverride || getSharePickerParentWindow();

  return new Promise((resolve) => {
    // 点击 Jitsi 共享按钮后立刻给会议窗口反馈，选择窗口出现后再关闭该加载态。
    sendToWindow(parentWindow, 'screen-share-picker-loading', true);

    const pickerWindow = new BrowserWindow({
      width: 760,
      height: 610,
      minWidth: 640,
      minHeight: 500,
      title: '选择共享内容',
      icon: getWindowIcon(),
      autoHideMenuBar: true,
      parent: parentWindow || undefined,
      modal: Boolean(parentWindow) && !options.switching,
      show: false,
      backgroundColor: '#f3f5f9',
      webPreferences: {
        contextIsolation: true,
        nodeIntegration: false,
        preload: path.join(__dirname, 'source-picker-preload.js'),
        webSecurity: true,
      },
    });

    // 选择器是一个独立工具窗口，不需要继承应用菜单栏。
    pickerWindow.setMenu(null);
    if (options.switching) pickerWindow.setAlwaysOnTop(true, 'screen-saver');
    // 选择器本身也排除在采集范围外，避免选择确认到共享启动之间被采进首帧。
    pickerWindow.setContentProtection(true);

    // 显示前同步位置到当前会议窗口附近，保证用户能立刻看到反馈。
    if (parentWindow && parentWindow !== pickerWindow) {
      const parentBounds = parentWindow.getBounds();
      const pickerBounds = pickerWindow.getBounds();
      const area = screen.getDisplayMatching(parentBounds).workArea;
      pickerWindow.setPosition(
        Math.round(Math.max(area.x, Math.min(parentBounds.x + (parentBounds.width - pickerBounds.width) / 2,
          area.x + area.width - pickerBounds.width))),
        Math.round(Math.max(area.y, Math.min(options.switching ? parentBounds.y + parentBounds.height + 10
          : parentBounds.y + (parentBounds.height - pickerBounds.height) / 2, area.y + area.height - pickerBounds.height)))
      );
    }

    const pickerRequest = {
      window: pickerWindow,
      sources: [],
      payload: { windows: [], screens: [] },
      sourcesPromise: null,
      resolve,
    };
    sharePickerRequests.set(requestId, pickerRequest);
    pickerRequest.sourcesPromise = loadSharePickerSources(requestId);

    pickerWindow.once('ready-to-show', () => {
      sendToWindow(parentWindow, 'screen-share-picker-loading', false);
      pickerWindow.show();
      pickerWindow.focus();
    });

    const abortPicker = () => finishSharePickerRequest(requestId);
    signal?.addEventListener('abort', abortPicker, { once: true });
    if (signal?.aborted) { abortPicker(); return; }
    pickerWindow.on('closed', () => {
      signal?.removeEventListener('abort', abortPicker);
      sendToWindow(parentWindow, 'screen-share-picker-loading', false);
      finishSharePickerRequest(requestId);
    });

    pickerWindow.loadFile(path.join(__dirname, 'source-picker.html'), { query: { requestId } });
  });
}

/**
 * 实测发现：个别深层嵌套 frame（如同源 Jitsi iframe）拿不到 session 注册的采集预加载（Electron 注入边界）。
 * 这里在 frame 导航后兜底注入采集运行时；注入代码借父 frame（同源）的传输桥完成 IPC。幂等。
 */
async function ensureCaptureRuntime(frame) {
  try {
    if (!frame || !/^https?:/.test(String(frame.url || ''))) return;
    const result = await frame.executeJavaScript(`(() => {
      try {
        if (window.__cloudmeetCapture) return 'already';
        if (!window.cloudmeetShareTransport) {
          try { window.cloudmeetShareTransport = window.parent ? window.parent.cloudmeetShareTransport : undefined; } catch (e) { /* 跨源时无父桥可借 */ }
        }
        if (!window.cloudmeetShareTransport) return 'no-bridge';
        (${installCaptureRuntime.toString()})();
        return window.__cloudmeetCapture ? 'installed' : 'failed';
      } catch (error) { return 'error:' + (error && error.message); }
    })()`);
    if (result === 'installed') {
      console.log('[screenshare] 采集运行时兜底注入成功:', frame.url);
    } else if (result !== 'already') {
      console.warn('[screenshare] 采集运行时注入失败:', result, frame.url);
    }
  } catch (error) {
    console.warn('[screenshare] 采集运行时注入异常', error);
  }
}

/** 窗口内每次 frame 导航后扫描整棵 frame 树，给缺采集运行时的 http(s) frame 兜底注入。 */
function attachCaptureRuntimeFallback(contents) {
  contents.on('did-frame-navigate', (_event, url) => {
    if (!/^https?:/.test(String(url || ''))) return;
    for (const frame of contents.mainFrame.framesInSubtree) {
      void ensureCaptureRuntime(frame);
    }
  });
}

/** 桌面端会议页运行在 iframe 中，统一补齐媒体权限和 Electron 屏幕共享源。 */
function configureMeetingSession() {
  shareController = createShareController({
    electron: { BrowserWindow, ipcMain, screen },
    selectSource: openSharePickerWindow, getWindowIcon,
    enableProtection: enableCaptureProtection, disableProtection: disableCaptureProtection,
  });
  session.defaultSession.registerPreloadScript({
    type: 'frame', filePath: path.join(__dirname, 'share-capture-preload.js'),
  });
  // 任何 frame 的采集预加载执行失败都在此现形（预加载注入失败时由 ensureCaptureRuntime 兜底）。
  app.on('web-contents-created', (_event, contents) => {
    if (contents.getType() !== 'window') return;
    attachCaptureRuntimeFallback(contents);
    contents.on('preload-error', (_e, preloadPath, error) => {
      console.warn(`[screenshare] 预加载执行失败 path=${preloadPath} error=${error?.message || error}`);
    });
  });

  const allowedPermissions = ['media', 'display-capture', 'fullscreen', 'clipboard-read', 'clipboard-sanitized-write'];
  session.defaultSession.setPermissionCheckHandler((_contents, permission) => allowedPermissions.includes(permission));
  session.defaultSession.setPermissionRequestHandler((_contents, permission, callback) => callback(allowedPermissions.includes(permission)));
  session.defaultSession.setDisplayMediaRequestHandler(async (request, callback) => {
    let settled = false;
    // Electron 新版对 callback({}) 的拒绝语义会同步抛 TypeError（页面请求仍被正确拒绝），
    // 拒绝路径吞掉这个已知异常，避免误报"获取屏幕共享源失败"。
    const finish = streams => {
      if (settled) return;
      settled = true;
      try {
        callback(streams);
      } catch (error) {
        if (!/no video stream was provided/.test(String(error?.message))) throw error;
      }
    };
    const shareWindow = getWindowForFrame(request.frame);
    try {
      if (request.audioRequested && !request.videoRequested) { finish({ audio: 'loopback' }); return; }
      const recordingFrame = consumePreparedRecordingCapture(request.frame);
      if (recordingFrame) {
        const streams = { video: recordingFrame };
        if (request.audioRequested) { streams.audio = recordingFrame; streams.enableLocalEcho = true; }
        finish(streams);
        return;
      }
      if (!isUsableWindow(shareWindow)) { finish({}); return; }
      const prepared = shareController.consumeSwitchSelection(request.frame);
      if (prepared) {
        const streams = { video: { id: prepared.source.id, name: prepared.source.name } };
        if (request.audioRequested && prepared.shareAudio) streams.audio = 'loopback';
        finish(streams);
        return;
      }
      if (shareController.hasActive()) { finish({}); return; }
      // 发起共享的 frame 必须有采集桥；兜底注入仍缺失时拒绝并提示（正常应在导航期就已注入）。
      await ensureCaptureRuntime(request.frame);
      if (!await request.frame.executeJavaScript('Boolean(window.__cloudmeetCapture)')) {
        console.warn('[screenshare] 采集桥不可用，拒绝本次共享请求:', request.frame?.url);
        finish({});
        return;
      }
      enableCaptureProtection(shareWindow);
      const selection = await openSharePickerWindow(shareWindow);
      if (!selection?.source || !isUsableWindow(shareWindow) || shareController.hasActive()) {
        if (!shareController.activeFor(shareWindow)) disableCaptureProtection();
        finish({});
        return;
      }
      const source = selection.source;
      shareController.authorize(request.frame, shareWindow, source, Boolean(selection.shareAudio));
      const streams = { video: { id: source.id, name: source.name } };
      if (request.audioRequested && selection.shareAudio) streams.audio = 'loopback';
      finish(streams);
    } catch (error) {
      console.error('获取屏幕共享源失败', error);
      if (!shareController.activeFor(shareWindow)) disableCaptureProtection();
      finish({});
    }
  });
}

// 共享选择器 IPC：选择器窗口只拿序列化数据，最终授权仍在主进程按 source id 完成。
ipcMain.handle('screen-share-picker-get-sources', (_event, requestId) => {
  const request = sharePickerRequests.get(String(requestId || ''));
  if (!request) {
    return { windows: [], screens: [] };
  }
  return request.sourcesPromise.catch((error) => {
    console.error('加载共享源失败', error);
    return { windows: [], screens: [], error: '获取共享内容失败，请稍后重试。' };
  });
});

ipcMain.on('screen-share-picker-select', (_event, payload) => {
  finishSharePickerRequest(String(payload?.requestId || ''), {
    sourceId: String(payload?.sourceId || ''),
    shareAudio: Boolean(payload?.shareAudio),
  });
});

ipcMain.on('screen-share-picker-cancel', (_event, requestId) => {
  finishSharePickerRequest(String(requestId || ''));
});

// ---------------------------------------------------------------------------
// 采集保护：共享期间把会议窗口标记为"禁止采集"（Windows 上对应 WDA_EXCLUDEFROMCAPTURE），
// 从根上消除会议窗口被采进自己共享画面的递归嵌套，不再依赖窗口必须保持最小化。
// ---------------------------------------------------------------------------

let captureProtectionWindow = null;

function enableCaptureProtection(win) {
  if (captureProtectionWindow === win) return;
  disableCaptureProtection();
  if (!isUsableWindow(win)) return;
  try {
    win.setContentProtection(true);
    captureProtectionWindow = win;
    console.log('[screenshare-guard] capture protection ON');
  } catch (error) {
    console.warn('开启采集保护失败', error);
  }
}

function disableCaptureProtection() {
  const win = captureProtectionWindow;
  captureProtectionWindow = null;
  if (!isUsableWindow(win)) return;
  try {
    win.setContentProtection(false);
    console.log('[screenshare-guard] capture protection OFF');
  } catch (error) {
    console.warn('关闭采集保护失败', error);
  }
}

// 共享会话、源切换、工具栏与范围提示统一由 share-controller 管理。

// 无边框窗口的自定义最小化/最大化/关闭控件：按发送事件的窗口操作，主窗口与会议窗口各自生效。
ipcMain.on('window-minimize', (event) => BrowserWindow.fromWebContents(event.sender)?.minimize());
ipcMain.on('window-maximize', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  if (!win) return;
  if (win.isMaximized()) {
    win.unmaximize();
  } else {
    win.maximize();
  }
});
ipcMain.on('window-toggle-fullscreen', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  if (!win) return;
  const nextFullscreen = !win.isFullScreen();
  win.setFullScreen(nextFullscreen);
  sendWindowFullscreenState(win, nextFullscreen);
});
ipcMain.on('window-set-fullscreen', (event, fullscreen) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  if (!win) return;
  const nextFullscreen = Boolean(fullscreen);
  win.setFullScreen(nextFullscreen);
  sendWindowFullscreenState(win, nextFullscreen);
});
ipcMain.handle('window-is-fullscreen', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  return Boolean(win?.isFullScreen());
});
ipcMain.on('window-close', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  if (!win) return;
  if (meetingWindows.has(win)) {
    // 会议窗口的离会协议已完成（或兜底超时），放行本次原生关闭。
    meetingCloseReady.add(win);
  }
  win.close();
});
ipcMain.on('window-set-title', (event, title) => {
  BrowserWindow.fromWebContents(event.sender)?.setTitle(title || '云会议');
});
// 跟随 Web 端主题切换原生 chrome（系统菜单栏等）：nativeTheme 全局生效，所有窗口一起变；
// 壳页面的自绘标题栏颜色由渲染层 data-theme + CSS 变量驱动（见 renderer.js applyShellTheme）。
ipcMain.on('native-theme', (_event, theme) => {
  nativeTheme.themeSource = theme === 'dark' ? 'dark' : 'light';
});
ipcMain.on('window-close-request', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  if (!win) return;
  if (meetingWindows.has(win)) {
    // 会议窗口关闭前先交给渲染层通知 iframe 离会，避免直接断开导致会中残留旧参会人。
    win.webContents.send('meeting-window-close-request');
    return;
  }
  win.close();
});
// 用户信息读写：桌面端存储为唯一权威来源，Web 端通过渲染层中转同步。
ipcMain.handle('user-get', () => readStoredUser());
ipcMain.handle('user-save', (_event, payload) => {
  const rawName = typeof payload === 'string' ? payload : payload?.name;
  const trimmed = typeof rawName === 'string' ? rawName.trim() : '';
  if (!trimmed) return readStoredUser();
  const stored = readStoredUser();
  const incomingUserId = typeof payload === 'string' ? '' : normalizeUserId(payload?.userId);
  const incomingLegacyUserIds = typeof payload === 'string' || !Array.isArray(payload?.legacyUserIds) ? [] : payload.legacyUserIds;
  const legacyUserIds = mergeLegacyUserIds(stored?.legacyUserIds ?? [], incomingUserId.length === 32 ? [incomingUserId] : [], incomingLegacyUserIds);
  const user = {
    name: trimmed,
    userId: stored?.userId || (incomingUserId.length === 32 ? incomingUserId.slice(0, 16) : incomingUserId) || createUserId(),
    ...(legacyUserIds.length ? { legacyUserIds } : {}),
  };
  writeStoredUser(user);
  return user;
});

// 服务器地址读写：用户配置优先于渲染层编译期 DEFAULT_URL；非法地址不覆盖现有配置。
ipcMain.handle('server-get', () => readStoredServerUrl());
ipcMain.handle('server-save', (_event, rawUrl) => {
  const url = normalizeServerUrl(rawUrl);
  if (!url) return readStoredServerUrl();
  writeStoredServerUrl(url);
  return url;
});

ipcMain.handle('settings-get', () => readStoredSettings());
ipcMain.handle('settings-save', (_event, settings) => {
  const saved = writeStoredSettings(settings);
  broadcastDesktopSettings(saved);
  return saved;
});
ipcMain.handle('recording-capture-prepare', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  return prepareRecordingCaptureForWindow(win);
});
ipcMain.handle('recording-directory-choose', async (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  const currentSettings = readStoredSettings();
  const options = {
    title: '选择录制文件保存目录',
    defaultPath: currentSettings.recording.directory,
    properties: ['openDirectory', 'createDirectory'],
  };
  const result = win
    ? await dialog.showOpenDialog(win, options)
    : await dialog.showOpenDialog(options);

  if (result.canceled || !result.filePaths?.[0]) {
    return currentSettings;
  }

  const saved = writeStoredSettings({
    ...currentSettings,
    recording: {
      ...currentSettings.recording,
      directory: result.filePaths[0],
    },
  });
  broadcastDesktopSettings(saved);
  return saved;
});
ipcMain.handle('recording-directory-open', async (_event, directory) => {
  const targetDirectory = normalizeRecordingDirectory(directory || readStoredSettings().recording.directory);
  try {
    fs.mkdirSync(targetDirectory, { recursive: true });
    const error = await shell.openPath(targetDirectory);
    return { ok: !error, error };
  } catch (error) {
    return { ok: false, error: error?.message || '打开目录失败' };
  }
});
ipcMain.handle('recording-session-start', (_event, options = {}) => {
  const settings = readStoredSettings();
  const directory = settings.recording.directory;
  fs.mkdirSync(directory, { recursive: true });

  const sessionId = crypto.randomUUID();
  const timestamp = formatRecordingTimestamp();
  const subject = sanitizeFileNamePart(options.subject || options.roomName || '会议录屏');
  const videoFilePath = uniqueRecordingPath(directory, `${timestamp}-${subject}.webm`);
  const mp4FilePath = uniqueRecordingPath(directory, `${timestamp}-${subject}.mp4`);
  const audioFilePath = options.recordAudioFile
    ? uniqueRecordingPath(directory, `${timestamp}-${subject}-audio.webm`)
    : '';

  const session = {
    videoFilePath,
    mp4FilePath,
    audioFilePath,
    videoStream: fs.createWriteStream(videoFilePath, { flags: 'wx' }),
    audioStream: audioFilePath ? fs.createWriteStream(audioFilePath, { flags: 'wx' }) : null,
  };
  recordingSessions.set(sessionId, session);

  return {
    sessionId,
    videoFilePath,
    ...(audioFilePath ? { audioFilePath } : {}),
  };
});
ipcMain.handle('recording-session-write', async (_event, payload = {}) => {
  const sessionId = String(payload.sessionId || '');
  const session = recordingSessions.get(sessionId);
  if (!session) {
    return { ok: false, error: '录制会话不存在' };
  }

  const kind = payload.kind === 'audio' ? 'audio' : 'video';
  const stream = kind === 'audio' ? session.audioStream : session.videoStream;
  if (!stream) {
    return { ok: true };
  }

  await writeStreamChunk(stream, normalizeChunkBuffer(payload.data));
  return { ok: true };
});
ipcMain.handle('recording-session-finish', async (_event, rawSessionId) => {
  const sessionId = String(rawSessionId || '');
  const session = recordingSessions.get(sessionId);
  if (!session) {
    return { ok: false, error: '录制会话不存在' };
  }

  recordingSessions.delete(sessionId);
  await Promise.all([closeWriteStream(session.videoStream), session.audioStream ? closeWriteStream(session.audioStream) : Promise.resolve()]);
  try {
    await transcodeWebmToMp4(session.videoFilePath, session.mp4FilePath);
    fs.unlinkSync(session.videoFilePath);
    return {
      ok: true,
      videoFilePath: session.mp4FilePath,
      videoFormat: 'mp4',
      ...(session.audioFilePath ? { audioFilePath: session.audioFilePath } : {}),
    };
  } catch (error) {
    try { fs.unlinkSync(session.mp4FilePath); } catch { /* ignore partial MP4 cleanup */ }
    console.warn('[recording] MP4 conversion failed; keeping WebM:', error?.message || error);
  }
  return {
    ok: true,
    videoFilePath: session.videoFilePath,
    videoFormat: 'webm',
    conversionError: 'MP4 转换失败，已保留 WebM 文件',
    ...(session.audioFilePath ? { audioFilePath: session.audioFilePath } : {}),
  };
});
ipcMain.handle('recording-session-cancel', (_event, rawSessionId) => {
  const sessionId = String(rawSessionId || '');
  const session = recordingSessions.get(sessionId);
  if (!session) {
    return { ok: true };
  }

  recordingSessions.delete(sessionId);
  destroyRecordingSession(session, true);
  return { ok: true };
});

// 会议在新开的独立桌面窗口进行，主窗口保持在首页。
// 会议 URL 通过 IPC 提供给新窗口的渲染层（不经过 loadFile query，避免特殊字符被破坏）。
const meetingWindows = new Map();

// 会议窗口使用系统原生边框/标题栏；close 事件拦截在 Jitsi 离会完成前不放行，
// 离会协议完成（cloudmeet-close-window → window-close）或兜底超时后标记放行。
const meetingCloseReady = new WeakSet();

function getMeetingWindowKey(url) {
  try {
    const parsed = new URL(url);
    // 同一个会议可能带不同一次性 query，按源站和路径去重，避免重复打开会议窗口。
    return `${parsed.origin}${parsed.pathname}`;
  } catch {
    return '';
  }
}

function findExistingMeetingWindow(url) {
  const targetKey = getMeetingWindowKey(url);
  if (!targetKey) return null;
  for (const [win, existingUrl] of meetingWindows.entries()) {
    if (isUsableWindow(win) && getMeetingWindowKey(existingUrl) === targetKey) {
      return win;
    }
  }
  return null;
}

/** Windows 11 无边框窗口默认带 DWM 圆角，深色主题下圆角边缘会露出桌面背景；
 *  通过 dwmapi 的 DWMWA_WINDOW_CORNER_PREFERENCE(33) 关闭圆角（DWMWCP_DONOTROUND=2）。 */
function disableWindowRoundedCorners(win) {
  if (process.platform !== 'win32' || !isUsableWindow(win)) return;
  const handle = win.getNativeWindowHandle();
  if (!handle || handle.length !== 4) return;
  const hwnd = handle.readUInt32LE(0);
  const script = [
    "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class CloudMeetDwm{[DllImport(\"dwmapi.dll\")]public static extern int DwmSetWindowAttribute(IntPtr h,int a,ref int v,int s);}';",
    `$v=2;[CloudMeetDwm]::DwmSetWindowAttribute([IntPtr]${hwnd},33,[ref]$v,4)`,
  ].join('');
  spawn('powershell.exe', ['-NoProfile', '-NonInteractive', '-WindowStyle', 'Hidden', '-Command', script], {
    windowsHide: true,
    stdio: 'ignore',
  });
}

function createMeetingWindow(url) {
  const perfStart = Date.now();
  const perfMark = label => console.info(`[meeting-perf] electron ${label}`, `${Date.now() - perfStart}ms`);
  perfMark('create-window-start');
  try {
    const parsed = new URL(url);
    if (!['http:', 'https:'].includes(parsed.protocol)) {
      return;
    }
  } catch {
    return;
  }

  const existingWindow = findExistingMeetingWindow(url);
  if (existingWindow) {
    focusWindow(existingWindow);
    return;
  }

  const win = new BrowserWindow({
    width: 1280,
    height: 820,
    minWidth: 900,
    minHeight: 620,
    title: '云会议',
    icon: getWindowIcon(),
    // 无边框窗口 + 自绘 40px 标题栏（主题文字/窗口按钮由渲染层绘制），保留 DWM 禁圆角。
    frame: false,
    autoHideMenuBar: true,
    backgroundColor: nativeTheme.shouldUseDarkColors ? '#0c1017' : '#f3f5f9',
    webPreferences: {
      contextIsolation: true,
      nodeIntegration: false,
      preload: path.join(__dirname, 'preload.js'),
      sandbox: true,
      nodeIntegrationInSubFrames: true,
      backgroundThrottling: false,
      webSecurity: true,
    },
  });
  // Windows 11 无边框窗口默认带 DWM 圆角，深色主题下圆角边缘会露出桌面背景。
  win.once('ready-to-show', () => disableWindowRoundedCorners(win));
  win.on('maximize', () => win.webContents.send('window-maximized', true));
  win.on('unmaximize', () => win.webContents.send('window-maximized', false));
  bindWindowFullscreenEvents(win);
  // 系统原生关闭（标题栏 ✕ / Alt+F4）先让 Jitsi 离会再关窗，避免会中残留参会人。
  // 重复点击原生 ✕ 只发送一次离会通知，超时兜底与离会完成两条路径都能放行。
  let closeRequestPending = false;
  win.on('close', (event) => {
    if (meetingCloseReady.has(win)) return;
    event.preventDefault();
    if (closeRequestPending) return;
    closeRequestPending = true;
    win.webContents.send('meeting-window-close-request');
    setTimeout(() => {
      meetingCloseReady.add(win);
      if (isUsableWindow(win)) win.close();
    }, 2000);
  });
  win.on('closed', () => {
    pendingRecordingCaptures.delete(win.id);
    meetingWindows.delete(win);
    // 会议窗口关闭后恢复并聚焦主窗口，让首页已收到的会后通知立即呈现给用户。
    focusWindow(mainWindow);
    quitIfNoContentWindow();
  });
  meetingWindows.set(win, url);
  // mode=meeting 供渲染层识别：会议窗口使用无边框自绘标题栏（40px），页面内容下移让出标题栏区域。
  win.loadFile(path.join(__dirname, 'index.html'), { query: { mode: 'meeting' } });
  perfMark('load-index-requested');
}

ipcMain.handle('open-meeting-window', (_event, url) => {
  createMeetingWindow(url);
});

ipcMain.handle('meeting-window-url', (event) => {
  const win = BrowserWindow.fromWebContents(event.sender);
  if (!win || !meetingWindows.has(win)) {
    return '';
  }
  return meetingWindows.get(win);
});

function createApplicationMenu() {
  const template = [
    {
      label: '文件',
      submenu: [
        {
          label: '退出',
          accelerator: 'Alt+F4',
          click: () => app.quit(),
        },
      ],
    },
    {
      label: '视图',
      submenu: [
        {
          label: '刷新会议页面',
          accelerator: 'F5',
          click: () => sendToRenderer('reload-iframe'),
        },
        {
          label: '重新加载窗口',
          accelerator: 'Ctrl+R',
          click: () => mainWindow?.reload(),
        },
        {
          label: '切换全屏',
          accelerator: 'F11',
          click: (_menuItem, focusedWindow) => {
            const win = focusedWindow || BrowserWindow.getFocusedWindow();
            if (!win) return;
            const nextFullscreen = !win.isFullScreen();
            win.setFullScreen(nextFullscreen);
            sendWindowFullscreenState(win, nextFullscreen);
          },
        },
        {
          label: '开发者工具',
          accelerator: 'Ctrl+Shift+I',
          click: () => mainWindow?.webContents.toggleDevTools(),
        },
      ],
    },
    {
      label: '窗口',
      submenu: [
        {
          label: '最小化',
          click: () => mainWindow?.minimize(),
        },
        {
          label: '关闭',
          click: () => mainWindow?.close(),
        },
      ],
    },
  ];

  Menu.setApplicationMenu(Menu.buildFromTemplate(template));
}

function createMainWindow() {
  mainWindow = new BrowserWindow({
    width: 1280,
    height: 820,
    minWidth: 900,
    minHeight: 620,
    title: '云会议',
    icon: getWindowIcon(),
    frame: false,
    backgroundColor: '#f3f5f9',
    show: false,
    webPreferences: {
      contextIsolation: true,
      nodeIntegration: false,
      preload: path.join(__dirname, 'preload.js'),
      sandbox: true,
      nodeIntegrationInSubFrames: true,
      backgroundThrottling: false,
      webSecurity: true,
    },
  });

  mainWindow.webContents.setWindowOpenHandler(({ url }) => {
    shell.openExternal(url);
    return { action: 'deny' };
  });

  mainWindow.once('ready-to-show', () => {
    mainWindow.show();
  });

  // 最大化状态变化同步给渲染层，用于切换"最大化/还原"图标。
  mainWindow.on('maximize', () => sendToRenderer('window-maximized', true));
  mainWindow.on('unmaximize', () => sendToRenderer('window-maximized', false));
  bindWindowFullscreenEvents(mainWindow);

  mainWindow.loadFile(path.join(__dirname, 'index.html'));
  mainWindow.webContents.once('did-finish-load', () => flushPendingInvite(mainWindow));

  mainWindow.on('closed', () => {
    mainWindow = null;
    quitIfNoContentWindow();
  });
}

registerProtocolClient();

const gotSingleInstanceLock = app.requestSingleInstanceLock();

if (!gotSingleInstanceLock) {
  app.quit();
} else {
  app.on('second-instance', (_event, argv) => {
    // 已打开应用时，系统会把新的 cloudmeet:// 链接传给主实例。
    dispatchInvite(parseInviteUrl(findProtocolUrl(argv)));
  });

  app.on('open-url', (event, url) => {
    // macOS 通过 open-url 事件传递自定义协议链接。
    event.preventDefault();
    dispatchInvite(parseInviteUrl(url));
  });

  app.whenReady().then(() => {
    configureMeetingSession();
    createMainWindow();
    createApplicationMenu();
    dispatchInvite(parseInviteUrl(findProtocolUrl(process.argv)));
  });
}

app.on('certificate-error', (event, _webContents, _url, _error, _certificate, callback) => {
  // 内网 Jitsi 常使用自签证书；桌面壳只负责加载用户配置的 iframe，因此允许继续加载。
  event.preventDefault();
  callback(true);
});

// GPU 进程异常退出（如 exit_code=34）：写标记并重启，下次启动切换为软件渲染。
app.on('child-process-gone', (_event, details) => {
  if (details.type === 'GPU' && details.reason !== 'clean-exit') {
    console.warn(`[gpu] GPU 进程异常退出（code=${details.exitCode}），切换软件渲染并重启`);
    try {
      fs.writeFileSync(gpuFallbackFlagPath, String(Date.now()));
    } catch (error) {
      console.warn('[gpu] 写入软件渲染标记失败', error);
    }
    app.relaunch();
    app.exit(0);
  }
});

app.on('before-quit', () => {
  shareController?.shutdown();
  for (const [sessionId, session] of recordingSessions.entries()) {
    recordingSessions.delete(sessionId);
    destroyRecordingSession(session);
  }
});

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') {
    app.quit();
  }
});

app.on('activate', () => {
  if (!hasContentWindow()) {
    createMainWindow();
  } else {
    flushPendingInvite();
  }
});
